+    const lines=[`Veröffentlichung ${index+1}: ${p.title||"ohne Titel"}${p.year?` (${p.year})`:""}`];
+    if(p.relevance)lines.push(`Bezug: ${p.relevance}`);
+    if(p.url)lines.push(`Quelle: ${p.url}`);
+    blocks.push(lines.join("\n"));
+  });
+
