+window.researchCandidateProfile=id=>{
+  const c=data.candidates.find(x=>x.id===id);
+  if(!c)return;
+  ensureCandidateResearch(c);
+
+  const region=$("#region")?.value?.trim()||"Lübeck, Schleswig-Holstein, Norddeutschland, Deutschland, Europa";
