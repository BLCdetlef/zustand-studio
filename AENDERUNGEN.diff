+/* Interviewtermine: kompakte chronologische Übersicht */
+.schedule-card{margin-bottom:18px}
+.schedule-head{margin-bottom:12px}
+.schedule-note{font-size:12px;color:var(--muted);white-space:nowrap}
+.schedule-list{display:grid;gap:8px}
+.schedule-group{display:grid;gap:7px}
+.schedule-group-title{font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin:2px 0 3px}
+.schedule-row{width:100%;display:grid;grid-template-columns:minmax(190px,auto) 90px 1fr;gap:12px;align-items:center;text-align:left;border:1px solid var(--line);border-radius:9px;background:#fff;padding:10px 12px;cursor:pointer;color:inherit}
+.schedule-row:hover{background:#f7f7f5}
+.schedule-date{font-weight:800;font-variant-numeric:tabular-nums}
+.schedule-type{justify-self:start;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.05em;border:1px solid #aaa;border-radius:999px;padding:4px 7px}
+.schedule-person{min-width:0;display:flex;flex-direction:column;gap:2px}
+.schedule-person strong,.schedule-person small{overflow-wrap:anywhere}
+.schedule-person small{font-size:12px;color:var(--muted)}
+.schedule-empty{margin:0;color:var(--muted);font-size:13px}
+.schedule-past{margin-top:5px;border-top:1px solid var(--line);padding-top:9px}
+.schedule-past summary{cursor:pointer;color:var(--muted);font-size:12px;font-weight:700;margin-bottom:8px}
+.interview-date-grid{margin-top:4px}
+@media(max-width:760px){
+  .schedule-head{align-items:flex-start;flex-direction:column;gap:4px}
+  .schedule-note{white-space:normal}
+  .schedule-row{grid-template-columns:1fr auto;gap:6px 10px}
+  .schedule-date{grid-column:1/2}
+  .schedule-type{grid-column:2/3;grid-row:1}
+  .schedule-person{grid-column:1/-1}
+}
