+  if(raw.contentType==="explainer"||keys.includes("natur verstehen"))return "Natur verstehen";
+  if(keys.includes("lösung"))return "Lösung";
+  if(keys.includes("querschnitt"))return "Querschnitt";
+  return "Zustand";
+}
